{
  "description": "Docker container resource usage and health monitoring",
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "panels": [

    {
      "datasource": "Prometheus",
      "fieldConfig": { "defaults": { "color": {"mode":"thresholds"}, "thresholds": {"mode":"absolute","steps":[{"color":"green","value":null},{"color":"yellow","value":3},{"color":"red","value":6}]} } },
      "gridPos": { "h": 3, "w": 4, "x": 0, "y": 0 },
      "id": 1,
      "options": { "colorMode": "background", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "title": "Running Containers",
      "type": "stat",
      "targets": [{ "datasource": "Prometheus", "expr": "count(container_last_seen{name!=\"\"})", "refId": "A" }]
    },

    {
      "datasource": "Prometheus",
      "fieldConfig": { "defaults": { "color": {"mode":"thresholds"}, "unit":"percent", "thresholds": {"mode":"absolute","steps":[{"color":"green","value":null},{"color":"yellow","value":50},{"color":"red","value":80}]} } },
      "gridPos": { "h": 3, "w": 4, "x": 4, "y": 0 },
      "id": 2,
      "options": { "colorMode": "background", "reduceOptions": { "calcs": ["mean"] } },
      "title": "Avg Container CPU",
      "type": "stat",
      "targets": [{ "datasource": "Prometheus", "expr": "avg(rate(container_cpu_usage_seconds_total{name!=\"\"}[5m])) * 100", "refId": "A" }]
    },

    {
      "datasource": "Prometheus",
      "fieldConfig": { "defaults": { "color": {"mode":"thresholds"}, "unit":"bytes", "thresholds": {"mode":"absolute","steps":[{"color":"green","value":null}]} } },
      "gridPos": { "h": 3, "w": 4, "x": 8, "y": 0 },
      "id": 3,
      "options": { "colorMode": "background", "reduceOptions": { "calcs": ["sum"] } },
      "title": "Total Container Memory",
      "type": "stat",
      "targets": [{ "datasource": "Prometheus", "expr": "sum(container_memory_usage_bytes{name!=\"\"})", "refId": "A" }]
    },

    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": { "color": {"mode":"palette-classic"}, "custom": {"fillOpacity":10,"lineWidth":2,"showPoints":"never"}, "unit":"percent" },
        "overrides": []
      },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 3 },
      "id": 4,
      "options": { "legend": { "calcs": ["mean","max","last"], "displayMode": "table", "placement": "bottom" } },
      "title": "CPU Usage per Container",
      "type": "timeseries",
      "targets": [{ "datasource": "Prometheus", "expr": "rate(container_cpu_usage_seconds_total{name!=\"\"}[5m]) * 100", "legendFormat": "{{ name }}", "refId": "A" }]
    },

    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": { "color": {"mode":"palette-classic"}, "custom": {"fillOpacity":10,"lineWidth":2,"showPoints":"never"}, "unit":"bytes" }
      },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 3 },
      "id": 5,
      "options": { "legend": { "calcs": ["mean","max","last"], "displayMode": "table", "placement": "bottom" } },
      "title": "Memory Usage per Container",
      "type": "timeseries",
      "targets": [{ "datasource": "Prometheus", "expr": "container_memory_usage_bytes{name!=\"\"}", "legendFormat": "{{ name }}", "refId": "A" }]
    },

    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": { "color": {"mode":"palette-classic"}, "custom": {"fillOpacity":8,"lineWidth":2,"showPoints":"never"}, "unit":"Bps" }
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 12 },
      "id": 6,
      "options": { "legend": { "calcs": ["mean","max"], "displayMode": "table", "placement": "bottom" } },
      "title": "Container Network I/O",
      "type": "timeseries",
      "targets": [
        { "datasource": "Prometheus", "expr": "rate(container_network_receive_bytes_total{name!=\"\"}[5m])", "legendFormat": "RX {{ name }}", "refId": "A" },
        { "datasource": "Prometheus", "expr": "rate(container_network_transmit_bytes_total{name!=\"\"}[5m])", "legendFormat": "TX {{ name }}", "refId": "B" }
      ]
    },

    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": { "color": {"mode":"palette-classic"}, "custom": {"fillOpacity":8,"lineWidth":2,"showPoints":"never"}, "unit":"Bps" }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "id": 7,
      "title": "Container Disk I/O",
      "type": "timeseries",
      "targets": [
        { "datasource": "Prometheus", "expr": "rate(container_fs_reads_bytes_total{name!=\"\"}[5m])", "legendFormat": "Read {{ name }}", "refId": "A" },
        { "datasource": "Prometheus", "expr": "rate(container_fs_writes_bytes_total{name!=\"\"}[5m])", "legendFormat": "Write {{ name }}", "refId": "B" }
      ]
    },

    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": { "color": {"mode":"palette-classic"}, "custom": {"fillOpacity":8,"lineWidth":2,"showPoints":"never"} }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "id": 8,
      "title": "Container Restart Count",
      "type": "timeseries",
      "targets": [{ "datasource": "Prometheus", "expr": "increase(container_start_time_seconds{name!=\"\"}[1h])", "legendFormat": "{{ name }}", "refId": "A" }]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 38,
  "tags": ["docker","containers","cadvisor"],
  "time": { "from": "now-1h", "to": "now" },
  "timezone": "browser",
  "title": "Container Monitoring",
  "uid": "container-monitor",
  "version": 1
}
