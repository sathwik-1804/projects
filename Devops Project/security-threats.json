{
  "description": "Security threat monitoring, log analysis, and intrusion detection",
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "panels": [

    {
      "datasource": "Loki",
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{"color":"green","value":null},{"color":"yellow","value":5},{"color":"red","value":20}] } } },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "id": 1,
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["sum"] } },
      "title": "Failed SSH Logins (5m)",
      "type": "stat",
      "targets": [{ "datasource": "Loki", "expr": "sum(count_over_time({job=\"auth\"} |~ \"(?i)failed password|invalid user\" [5m]))", "refId": "A" }]
    },

    {
      "datasource": "Loki",
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{"color":"green","value":null},{"color":"red","value":1}] } } },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "id": 2,
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["sum"] } },
      "title": "Sudo Failures (10m)",
      "type": "stat",
      "targets": [{ "datasource": "Loki", "expr": "sum(count_over_time({job=\"auth\"} |~ \"(?i)sudo.*FAILED|incorrect password\" [10m]))", "refId": "A" }]
    },

    {
      "datasource": "Prometheus",
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "unit": "Bps", "thresholds": { "mode": "absolute", "steps": [{"color":"green","value":null},{"color":"yellow","value":50000000},{"color":"red","value":100000000}] } } },
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "id": 3,
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "title": "Network Inbound Rate",
      "type": "stat",
      "targets": [{ "datasource": "Prometheus", "expr": "sum(rate(node_network_receive_bytes_total{device!~\"lo|docker.*|veth.*\"}[5m]))", "refId": "A" }]
    },

    {
      "datasource": "Prometheus",
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{"color":"green","value":null},{"color":"yellow","value":5},{"color":"red","value":20}] } } },
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "id": 4,
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "title": "Active TCP Connections",
      "type": "stat",
      "targets": [{ "datasource": "Prometheus", "expr": "node_sockstat_TCP_alloc", "refId": "A" }]
    },

    {
      "datasource": "Loki",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "id": 5,
      "options": { "dedupStrategy": "none", "enableLogDetails": true, "prettifyLogMessage": false, "showTime": true, "sortOrder": "Descending" },
      "title": "Auth Log Stream — Failed Attempts",
      "type": "logs",
      "targets": [{ "datasource": "Loki", "expr": "{job=\"auth\"} |~ \"(?i)(failed password|invalid user|authentication failure|refused connect)\"", "refId": "A" }]
    },

    {
      "datasource": "Loki",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "id": 6,
      "options": { "dedupStrategy": "none", "enableLogDetails": true, "showTime": true, "sortOrder": "Descending" },
      "title": "Kernel / System Security Events",
      "type": "logs",
      "targets": [{ "datasource": "Loki", "expr": "{job=\"kernel\"} |~ \"(?i)(error|critical|oom|killed|segfault|denied)\"", "refId": "A" }]
    },

    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "custom": { "fillOpacity": 10, "lineWidth": 2, "showPoints": "never" }, "unit": "Bps" }
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 12 },
      "id": 7,
      "options": { "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom" } },
      "title": "Network Traffic Anomaly Detection (Inbound vs Outbound)",
      "type": "timeseries",
      "targets": [
        { "datasource": "Prometheus", "expr": "rate(node_network_receive_bytes_total{device!~\"lo|docker.*|veth.*\"}[5m])", "legendFormat": "RX {{ device }}", "refId": "A" },
        { "datasource": "Prometheus", "expr": "rate(node_network_transmit_bytes_total{device!~\"lo|docker.*|veth.*\"}[5m])", "legendFormat": "TX {{ device }}", "refId": "B" }
      ]
    },

    {
      "datasource": "Prometheus",
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "custom": { "fillOpacity": 8, "lineWidth": 2, "showPoints": "never" } } },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "id": 8,
      "title": "Network Error Rate",
      "type": "timeseries",
      "targets": [
        { "datasource": "Prometheus", "expr": "rate(node_network_receive_errs_total[5m])", "legendFormat": "RX Errors {{ device }}", "refId": "A" },
        { "datasource": "Prometheus", "expr": "rate(node_network_transmit_errs_total[5m])", "legendFormat": "TX Errors {{ device }}", "refId": "B" }
      ]
    },

    {
      "datasource": "Prometheus",
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "custom": { "fillOpacity": 8, "lineWidth": 2, "showPoints": "never" } } },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "id": 9,
      "title": "TCP Socket States",
      "type": "timeseries",
      "targets": [
        { "datasource": "Prometheus", "expr": "node_sockstat_TCP_alloc", "legendFormat": "Allocated", "refId": "A" },
        { "datasource": "Prometheus", "expr": "node_sockstat_TCP_tw", "legendFormat": "Time Wait", "refId": "B" },
        { "datasource": "Prometheus", "expr": "node_sockstat_TCP_inuse", "legendFormat": "In Use", "refId": "C" }
      ]
    }
  ],
  "refresh": "15s",
  "schemaVersion": 38,
  "tags": ["security", "threat-detection", "logs"],
  "time": { "from": "now-1h", "to": "now" },
  "timezone": "browser",
  "title": "Security & Threat Detection",
  "uid": "security-threats",
  "version": 1
}
